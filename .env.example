# 使用方法：把本文件复制为 .env，再填入真实值。
# .env 已在 .gitignore 中，请勿提交到 Git，也不要写进任何会被手机页面访问到的文件。

# ---- 多模态识别（OpenAI 兼容接口）----
# API Key，必填
OPENAI_API_KEY=
# 接口地址，需包含 /v1（不同服务商路径可能不同）
OPENAI_BASE_URL=https://api.openai.com/v1
# 视觉模型名，必填。换模型只改这一行，代码无需改动
VISION_MODEL=

# ---- 手机局域网上传服务 ----
UPLOAD_PORT=8765

# ---- 每日提醒时间（24 小时制 HH:MM）----
REMINDER_TIME=21:00